# Contact form delivery (src/app/api/contact/route.js).
# Copy to .env.local for development, and set the same values on the server.
#
# 1. Create a free account at https://resend.com
# 2. Verify the nexarrow.eu domain there (it gives you DNS records to add)
# 3. Create an API key and paste it below
#
# Without RESEND_API_KEY the form still works: it offers the visitor a
# pre-filled email to hello@nexarrow.eu instead of sending from the site.

RESEND_API_KEY=
# A sender on the verified domain.
CONTACT_FROM="Nexarrow website <website@nexarrow.eu>"
# Where briefs arrive. Defaults to hello@nexarrow.eu.
CONTACT_TO=hello@nexarrow.eu
